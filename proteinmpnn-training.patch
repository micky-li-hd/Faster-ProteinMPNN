+def _preserve_low_precision_casts(graph):
+    """Keep explicit AOT forward/backward half-rounding points under Inductor."""
+    nodes = graph.nodes if hasattr(graph, 'nodes') else graph.graph.nodes
+    for node in nodes:
+        if (node.op == 'call_function'
+                and node.target == torch.ops.prims.convert_element_type.default
+                and len(node.args) > 1
+                and node.args[1] in (torch.float16, torch.bfloat16)):
+            node.meta['low_precision_pointwise_barrier'] = True
 
 
